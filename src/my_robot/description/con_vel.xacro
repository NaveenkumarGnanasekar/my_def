<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo>
        <plugin name="turret_velocity_controller" filename="libgazebo_ros_joint_state_publisher.so">
            <joint_name>JOINT_TURRET</joint_name>
            <update_rate>50</update_rate>
            <initial_position>0</initial_position>
            <initial_velocity>1.0</initial_velocity>  <!-- Angular velocity (rad/s) -->
            <ros>
                <namespace>/</namespace>
                <remapping>cmd_vel:=/cmd_vel</remapping>
            </ros>
        </plugin>
    </gazebo>
</robot>